# Copy to .env and fill in. Never commit .env.
# Only VITE_* variables are exposed to the browser bundle; never put secrets there.

# Supabase cloud dev project (client, safe to expose: the publishable key is public by design,
# RLS protects data). Dashboard → Project Settings → API Keys.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets live in Supabase secrets / GitHub Actions secrets, not here:
# SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, VAPID_PRIVATE_KEY, TURNSTILE_SECRET_KEY, ANTHROPIC_API_KEY
