  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supabase": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
